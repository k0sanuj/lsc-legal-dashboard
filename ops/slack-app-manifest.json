{
  "display_information": {
    "name": "Autonomos",
    "description": "Autonomos: agreements, signatures and legal status. From autos (self) and nomos (law).",
    "background_color": "#020617"
  },
  "features": {
    "app_home": {},
    "bot_user": {
      "display_name": "Autonomos",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/legal",
        "url": "https://lsc-legal-dashboard.vercel.app/api/slack/commands",
        "description": "Legal status, signatures in flight, agreement lookup",
        "should_escape": false,
        "usage_hint": "[status | signatures | find \u003cquery\u003e | help]"
      },
      {
        "command": "/mnda",
        "url": "https://lsc-legal-dashboard.vercel.app/api/slack/commands",
        "description": "Send an MNDA for signature",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "chat:write.public",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": false,
    "org_deploy_enabled": false,
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://lsc-legal-dashboard.vercel.app/api/slack/interactivity"
    },
    "token_rotation_enabled": false
  }
}
