# OpenSign server/client runtime config, rendered to .env.prod on the VM by deploy.sh.
# Never commit a filled-in copy of this file.

# --- Identity / core ---
appName=LSC Legal E-Sign
APP_ID=opensign
REACT_APP_APPID=opensign
PARSE_MOUNT=/app
GENERATE_SOURCEMAP=false

# 12+ character random secret. deploy.sh generates one if not supplied.
MASTER_KEY=

# Mongo runs inside the compose network; the hostname is the container name.
MONGODB_URI=mongodb://mongo-container:27017/OpenSignDB

# --- Mail (Mailgun) ---
# OpenSign refuses to initialise unless Mailgun or SMTP is configured.
# SMTP_ENABLE must stay false so the Mailgun driver is used.
#
# Use the same sending domain as the dashboard: futureofsports.io, which is
# already verified in Mailgun with SPF, DKIM, tracking and DMARC in place.
# Send as legal@futureofsports.io so the From address stays aligned.
#
# NOTE: the OpenSign image talks to the US Mailgun host. If the account is in
# the EU region, this driver will 401 with a key that is actually valid; switch
# OpenSign to SMTP in that case (smtp.eu.mailgun.org, port 587) and set
# SMTP_ENABLE=true with SMTP_USER_EMAIL / SMTP_PASS from Mailgun's SMTP
# credentials rather than the API key.
SMTP_ENABLE=false
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SENDER=

# --- File storage ---
# Local volume storage. The Legal Dashboard webhook downloads the completed PDF
# over HTTPS and re-uploads it to the LSC S3 bucket, so OpenSign does not need
# its own S3 credentials.
USE_LOCAL=true

# Optional: point OpenSign at S3-compatible storage instead of the local volume.
# Only needed if signed-PDF downloads from the local volume are not reachable.
# DO_SPACE=
# DO_ENDPOINT=s3.<region>.amazonaws.com
# DO_BASEURL=https://<bucket>.s3.<region>.amazonaws.com
# DO_ACCESS_KEY_ID=
# DO_SECRET_ACCESS_KEY=
# DO_REGION=

# --- Document signing certificate ---
# Base64 PFX/p12 used to seal completed PDFs, plus its passphrase. REQUIRED:
# without them every signing completion crashes in signpdf with
# Buffer.from(undefined) at PDF.js:462 and the signer sees "something went
# wrong" (happened in production 2026-08-30). The live values are the FSP
# document-sealing certificate stored in Secret Manager (project
# fresh-authority-499619-r7, secrets OPENSIGN_PFX_BASE64 and
# OPENSIGN_PFX_PASSPHRASE). The p12 MUST be exported with legacy ciphers
# (openssl pkcs12 -export -legacy); OpenSign signs via @signpdf/signer-p12,
# whose node-forge cannot parse OpenSSL 3's default AES-256 PBES2 encryption.
# PFX_BASE64=
# PASS_PHRASE=
